{
  "expo": {
    "name": "ShowReady",
    "slug": "showready-native-rebuild",
    "scheme": "showready",
    "icon": "./assets/app-icon.png",
    "plugins": [
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-apple-authentication",
      "expo-notifications",
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.showready.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0D1B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.showready.mobile",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4c5b8450-3f56-419a-aa0c-990e93d99086"
      }
    },
    "owner": "gopi_chand"
  }
}
